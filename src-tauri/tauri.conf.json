{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KARSA",
  "version": "1.6.1",
  "identifier": "id.karsa.rkas2026",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://127.0.0.1:9200",
    "beforeDevCommand": "php artisan serve --host=127.0.0.1 --port=9200",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../app": "./app/",
      "../bootstrap": "./bootstrap/",
      "../config": "./config/",
      "../database/migrations": "./database/migrations/",
      "../database/seeders/DatabaseSeeder.php": "./database/seeders/DatabaseSeeder.php",
      "../database/seeders/SmartRkasMasterSeeder.php": "./database/seeders/SmartRkasMasterSeeder.php",
      "../database/seeders/JuknisSeeder.php": "./database/seeders/JuknisSeeder.php",
      "../database/seeders/ArkasKodeBarangSeeder.php": "./database/seeders/ArkasKodeBarangSeeder.php",
      "../database/seeders/data": "./database/seeders/data/",
      "../public": "./public/",
      "../resources/views": "./resources/views/",
      "../resources/database-seed.sqlite": "./resources/database-seed.sqlite",
      "../routes": "./routes/",
      "../vendor": "./vendor/",
      "../artisan": "./artisan",
      "bundle-env/.env": "./.env",
      "php": "./php/"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./installer.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Mukhamadirfan1997/RKAS-APP/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEN0EzRkMwMTI0Nzc2QjEKUldTeGRrY1N3RDk2amU2S2VKb0Fick1MWGtpa0R6Tk5PR3BDOTFkTW5kNzgvOUFoWXY2VGg3SmgK",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}