{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KARSA",
  "version": "1.5.1",
  "identifier": "id.karsa.rkas2026",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://127.0.0.1:9200",
    "beforeDevCommand": "php artisan serve --host=127.0.0.1 --port=9200",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../app": "./app/",
      "../bootstrap": "./bootstrap/",
      "../config": "./config/",
      "../database/migrations": "./database/migrations/",
      "../database/factories": "./database/factories/",
      "../database/seeders": "./database/seeders/",
      "../database/.gitignore": "./database/.gitignore",
      "../public": "./public/",
      "../resources": "./resources/",
      "../routes": "./routes/",
      "../vendor": "./vendor/",
      "../artisan": "./artisan",
      "../composer.json": "./composer.json",
      "../composer.lock": "./composer.lock",
      "bundle-env/.env": "./.env",
      "php": "./php/"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Mukhamadirfan1997/RKAS-APP/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEN0EzRkMwMTI0Nzc2QjEKUldTeGRrY1N3RDk2amU2S2VKb0Fick1MWGtpa0R6Tk5PR3BDOTFkTW5kNzgvOUFoWXY2VGg3SmgK",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}