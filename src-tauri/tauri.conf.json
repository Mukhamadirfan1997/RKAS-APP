{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RKAS 2026",
  "version": "0.1.0",
  "identifier": "id.smartrkas.rkas2026",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://127.0.0.1:9200",
    "beforeDevCommand": "php artisan serve --host=127.0.0.1 --port=9200",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}